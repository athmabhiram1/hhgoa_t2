server {
    listen ${PORT};
    server_name _;
    root /var/www/html;
    index index.html;

    # Locked Aug 2026: Sarvam STT accepts audio up to ~4MB; nginx default is
    # 1M which 413s anything larger before it reaches FastAPI.
    client_max_body_size 8M;

    # API proxy to the FastAPI backend in the same container.
    location /v1/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;           # stream SSE events immediately
        proxy_read_timeout 120s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}