# =============================================================================
# VakRAG — Environment Configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# =============================================================================

# ------------------------------------------------------------------ API keys
# Sarvam AI (STT primary) — https://indus.sarvam.ai  (100 free credits)
SARVAM_API_KEY=
# Google Gemini (generation LLM primary) — https://aistudio.google.com/apikey
# NOTE: Gemini 2.0 Flash-Lite is retired (2026-06-01). Use a current Flash-Lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Groq (pluggable generation LLM, optional)
GROQ_API_KEY=
# OpenAI (pluggable generation LLM, optional)
OPENAI_API_KEY=

# ------------------------------------------------------------- LLM provider
# Primary generation provider: gemini | ollama | groq | openai
PRIMARY_LLM_PROVIDER=gemini
# Indexing/extraction LLM (LightRAG deep path) — local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Local generation fallback model on RTX 5050
OLLAMA_FALLBACK_MODEL=llama3.2:3b

# ------------------------------------------------------------------ Neo4j
# Local Docker: neo4j://localhost:7687   Cloud Aura: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
# Index label/namespace (change to re-index from scratch)
NEO4J_INDEX_NAMESPACE=vakrag_v1

# ------------------------------------------------------------- Embeddings
# Local Qwen3-Embedding via Ollama /api/embed (1024-dim, dense-only; the
# lexical/BM25 arm is served by Neo4j Lucene fulltext). Immutable after first index.
EMBED_BACKEND=ollama        # ollama | fastembed | sentence-transformers
EMBED_MODEL=BAAI/bge-m3     # used by fastembed / sentence-transformers fallback
EMBED_DEVICE=cpu            # cpu | cuda (RTX 5050)
EMBED_ONNX_DIR=./models/bge-m3-onnx
EMBED_DIM=1024
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBED_DIM=1024
OLLAMA_EMBED_NUM_BATCH=1024     # 512->1024 = +50-80% embed throughput on GPU
OLLAMA_EMBED_KEEP_ALIVE=5m      # keep model loaded between embed batches
OLLAMA_BASE_URL=http://localhost:11434
EMBED_BATCH_SIZE=128            # chunks per embed HTTP call (amortizes latency)
# Request-path embed concurrency bound (Phase 6): limits in-flight embeds to
# Ollama's serial /api/embed; a "queued" SSE stage event surfaces contention.
EMBED_CONCURRENCY=2             # bound 2-3 per directive

# --------------------------------------------------------------- Retrieval
# Hybrid fusion weights (RRF constant and rank caps)
RETRIEVAL_VECTOR_K=40
RETRIEVAL_BM25_K=40
RETRIEVAL_FUSION_TOPK=12
RETRIEVAL_RRF_K=60
# Rerank: none | local (bge-reranker-v2-m3)
RETRIEVAL_RERANK=none
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# --------------------------------------------------------------- Guardrails
GUARD_SAFETY=on
GUARD_OFFTOPIC=on
GUARD_GROUNDING=on
GUARD_GROUNDING_THRESHOLD=0.78
GUARD_FAITHFULNESS=on
# optional LLM judge for borderline cases: on | off
GUARD_LLM_JUDGE=off

# ------------------------------------------------------------------ Dataset
# HF token for dataset downloads (optional; speeds up/resumes big files)
HF_TOKEN=
# Language configs to sample; "all" = all 14 Indic languages
DATASET_NAME=ai4bharat/MSMARCO-XI
DATASET_LANGS=all
# Sampling split: "validation" (14x~450MB, all langs incl. Telugu, demo default)
# or "train" (13x~3.5GB, no Telugu — disk-heavy). See CONTEXT.md "Dataset".
DATASET_SPLIT=validation
# Total passages to index across the whole sample (~150-200k recommended)
DATASET_MAX_PASSAGES=180000
# Max passages per query used from the 10 provided (capped for speed)
DATASET_MAX_PASSAGES_PER_QUERY=10
# Seeded RNG for reproducible balanced sampling
DATASET_SEED=42

# ------------------------------------------------------------------- Server
HOST=0.0.0.0
PORT=8000
# Enable OpenTelemetry/Langfuse-compatible logging
OTEL_EXPORTER=console        # console | langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --------------------------------------------------------------- Benchmarks
BENCHMARK_N_QUERIES=150
BENCHMARK_OUTDIR=./benchmarks
